# demo runs without access to real DNS. Live mode requires explicit config.
INFRAPILOT_MODE=demo
INFRAPILOT_LISTEN_ADDRESS=127.0.0.1
INFRAPILOT_HTTP_PORT=8088
INFRAPILOT_ADMIN_USERNAME=admin
# Required in live mode: unique password, at least 16 characters.
INFRAPILOT_ADMIN_PASSWORD=
INFRAPILOT_VIEWER_USERNAME=viewer
INFRAPILOT_VIEWER_PASSWORD=
# Set true behind an HTTPS reverse proxy.
INFRAPILOT_SESSION_COOKIE_SECURE=false
INFRAPILOT_TSIG_SECRET=

# Optional external PostgreSQL (provided separately).
# INFRAPILOT_DATABASE_URL=jdbc:postgresql://postgres:5432/infrapilot
# INFRAPILOT_DATABASE_USERNAME=infrapilot
# INFRAPILOT_DATABASE_PASSWORD=replace-with-generated-password
# INFRAPILOT_POSTGRES_PASSWORD=replace-with-independent-admin-password

# Optional DHCP management. Configure both Kea Control Agent endpoints.
INFRAPILOT_DHCP_ENABLED=false
INFRAPILOT_KEA1_API_URL=http://192.0.2.21:8000/
INFRAPILOT_KEA1_API_USERNAME=infrapilot
INFRAPILOT_KEA1_API_PASSWORD=
INFRAPILOT_KEA2_API_URL=http://192.0.2.22:8000/
INFRAPILOT_KEA2_API_USERNAME=infrapilot
INFRAPILOT_KEA2_API_PASSWORD=

# Optional Application Gateway (APISIX Admin API). Credentials stay on the backend.
INFRAPILOT_GATEWAY_ENABLED=false
INFRAPILOT_GATEWAY_URL=http://192.0.2.20:9180
INFRAPILOT_GATEWAY_API_KEY=
# Optional read-only bind mount of the node's config.yaml at this container path.
INFRAPILOT_GATEWAY_RUNTIME_CONFIG_FILE=

# Optional conditional forwarding. Use an independent, forced-command SSH key.
# Configure both BIND nodes in the private deployment YAML; see docs/CONDITIONAL-FORWARDING.md.
INFRAPILOT_FORWARDING_ENABLED=false
INFRAPILOT_FORWARDING_PRIVATE_KEY_FILE=
INFRAPILOT_FORWARDING_KNOWN_HOSTS_FILE=
INFRAPILOT_BIND_ENABLED=false
INFRAPILOT_BIND_PRIVATE_KEY_FILE=
INFRAPILOT_BIND_KNOWN_HOSTS_FILE=
INFRAPILOT_BIND_BACKUP_DIRECTORY=/app/data/bind
